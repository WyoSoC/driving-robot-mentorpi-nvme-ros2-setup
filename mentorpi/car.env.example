# Per-car settings for the MentorPi system. Copy to car.env (install.sh does this).
# car.env is NOT shared between cars.

# Friendly name shown in logs (convention: the hostname).
CAR_NAME=jpi2

# ROS 2 DDS domain. Must be UNIQUE per car on the same network (0-101),
# otherwise one car's web UI / joystick commands reach the other car.
# Convention: the number in the hostname (jpi1 -> 1, jpi2 -> 2).
ROS_DOMAIN_ID=2

# RRC Lite PWM port of the steering servo. Our standard wiring is 4 (Hiwonder's docs use J5 =
# port 3). Check: lift the front wheels, run tools/steer_test.sh; the wheels must turn.
STEER_SERVO_PORT=4

# Port for the web control UI (rosbridge stays on 9090, video on 8080).
WEB_UI_PORT=8000

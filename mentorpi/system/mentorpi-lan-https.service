[Unit]
Description=MentorPi page over HTTPS on the local network (443/8443/8444 on local addresses)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 @DIR@/system/lan_https.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

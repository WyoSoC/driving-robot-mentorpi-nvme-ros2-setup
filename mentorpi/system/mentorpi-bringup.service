[Unit]
Description=MentorPi ROS2 bringup (inside container)
Requires=mentorpi-container.service
After=mentorpi-container.service

[Service]
Type=simple
User=@USER@
# Give USB serial devices a moment to appear after boot
ExecStartPre=/bin/bash -c 'for i in $(seq 30); do [ -e /dev/rrc ] && [ -e /dev/ldlidar ] && exit 0; sleep 1; done; echo "WARNING: /dev/rrc or /dev/ldlidar missing" >&2'
ExecStart=@DIR@/start_node.sh
ExecStop=/usr/bin/docker exec -u ubuntu MentorPi /home/ubuntu/.stop_ros.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

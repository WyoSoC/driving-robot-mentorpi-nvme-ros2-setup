[Unit]
Description=MentorPi Factory Docker Container
Requires=docker.service
After=docker.service

[Service]
Type=simple
Restart=no
User=gojian
Environment="DISPLAY=:0"
ExecStartPre=/bin/bash -c 'docker rm -f MentorPi 2>/dev/null || true'
ExecStart=/bin/bash /home/gojian/mentorpi/run_container.sh
ExecStartPost=/bin/bash /home/gojian/mentorpi/start_node.sh

[Install]
WantedBy=multi-user.target

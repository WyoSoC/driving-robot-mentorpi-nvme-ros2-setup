#!/bin/bash

# MentorPi native (Option 2) environment configuration
# Mirror of the factory Docker container's .typerc, adapted for the NVMe setup.

export VERSION="|V2.0.0|native|"

# Lidar type: A1 / G4 / LD14P / LD19 / MS200
export LIDAR_TYPE=MS200

# Depth camera type: ascamera / None
export DEPTH_CAMERA_TYPE=ascamera

# Chassis type: MentorPi_Acker (Ackermann) or MentorPi_Mecanum
export MACHINE_TYPE=MentorPi_Acker

# Multi-robot: leave as / for single robot
export HOST=/
export MASTER=/

# Voice language: Chinese / English
export ASR_LANGUAGE=English

# Build mode: True = use source, False = use installed packages
export need_compile=True

export ROS_DOMAIN_ID=0
export CYCLONEDDS_URI=file:///etc/cyclonedds/config.xml

echo -e "\033[32m----------------------------------------------"
echo -e "MentorPi Native ROS2 (Option 2)"
echo -e "----------------------------------------------\033[0m"
echo -e "LIDAR:        \033[32m$LIDAR_TYPE\033[0m"
echo -e "CAMERA:       \033[32m$DEPTH_CAMERA_TYPE\033[0m"
echo -e "MACHINE:      \033[32m$MACHINE_TYPE\033[0m"
echo -e "ROS_DOMAIN_ID:\033[32m $ROS_DOMAIN_ID\033[0m"
echo -e "VERSION:      \033[32m$VERSION\033[0m"
